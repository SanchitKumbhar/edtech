# ==============================================================================
# Focus Flair - Production Environment Configuration Template
# ==============================================================================

# Server Network & Process
PORT=5000
NODE_ENV=development
TRUST_PROXY=1
CORS_ORIGIN=http://localhost:8080

# MongoDB Database Configuration
# In production, use replica set URI: mongodb+srv://<user>:<password>@cluster.mongodb.net/exam_prep_db
MONGODB_URI=mongodb://127.0.0.1:27017/exam_prep_db
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_TIMEOUT_MS=15000

# Redis Infrastructure Configuration
# Connect via standalone URL or host/port parameters
REDIS_URL=redis://127.0.0.1:6379
# Alternatively:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Authentication & Security
JWT_SECRET=change-this-secret-to-a-secure-random-key-in-production
JWT_EXPIRES_IN=7d
STRICT_SOCKET_AUTH=true

# Background Worker Concurrency
# Set to 'true' to run workers inside the web process (dev/single-node), or 'false' in production cluster where dedicated worker containers run 'npm run worker'
RUN_EMBEDDED_WORKER=true
